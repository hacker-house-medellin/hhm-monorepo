  },
  "apps": [
    "api",
    "web",
    "ops-console",
    "control-plane"
  ],
  "packages": [
    "contracts",
    "ui",
    "testkit",
    "catalog"
  ],
  "repositories": [
    "hhm-interfaces",
    "hhm-api",
    "hhm-web-mash",
    "hhm-web-leptos",
    "hhm-web-dioxus",
    "hhm-cli",
    "hhm-sync",
    "hhm-infra",
    "hhm-clients",
    "hhm-libs",
    "hacker-house-medellin.github.io"
  ],
  "capabilities": [
    "bookings",
    "occupancy",
    "community",
    "events",
    "alerts",
    "audit"
  ],
  "integrations": [
    "Booking calendars",
    "Door access",
    "Stripe",
    "WhatsApp",
    "Community events",
    "Occupancy sensors"
  ],
  "language_support": {
    "atto": {
      "phase": "draft-source-contract",
